# Firebase web config (Firebase console > Project settings > Your apps > Web app).
# Production values live in .env.production. For `npm run dev`, an empty API key means dev mode
# (sign-in by email only; the backend must run with AUTH_PROVIDER=dev). Copy .env.production to
# .env.local to use real Firebase sign-in locally.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
